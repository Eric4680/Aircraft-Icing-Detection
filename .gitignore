# Local Python environments and application runtime files
.venv/
.venv-*/
.runtime/
__pycache__/
*.pyc
*.pyo

# Local secrets; keep shareable examples
.env
.env.*
!.env.example
!.env.template

# Generated application packages
/Apps/**/build/
/Apps/**/dist/

# Keep version-one dataset available to collaborators; exclude other local data
/Datasets/*
!/Datasets/.gitkeep
!/Datasets/Manifests/
!/Datasets/v1_annotated/
/Datasets/v1_annotated/*
!/Datasets/v1_annotated/Aircraft Ice Detection.v1i.yolo26.zip

# Exclude local model artifacts except the shared version-one checkpoint
/Models/**/*.pt
/Models/**/*.pth
/Models/**/*.onnx
/Models/**/*.engine
/Models/**/*.ckpt
/Models/**/*.safetensors
/Models/**/*.tflite
!/Models/aircraft-ice-detection-1-yolo26s-t1/weights.pt

# OS-generated files
Thumbs.db
.DS_Store
